# disco para reprocessar, mas fora do repositorio e fora do upload de deploy.
assets/img/engenharia/processos/elux/*.JPEG
assets/img/engenharia/processos/elux/*.MOV
assets/img/engenharia/processos/elux/*.jpg
!assets/img/engenharia/processos/elux/web/
